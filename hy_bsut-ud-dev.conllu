# sent_id = fiction-007N-00130DM6
# text = Ռուբենը գալիք պայթյուններից էլ ավելի ջլապնդվեց. ինքնամոռաց լափ տալով՝ չնկատեց ինչպես աղջկա բիբերը լայնացան, սևը պատեց ծիածանաթաղանթն ու դուրս եկավ շրջանագծերից, ներկեց սպիտակուցները ձյութով, աչքերից ծոր տվեց, մտավ Նվարդի լայնացող կլափի մեջ, ուրկից հազարներով մանկան օտար երգ-երգոց դուրս գայթեցին, տարածվեցին երկնքով մեկ ու մեռելոտ ճռվողյուն դարձած ետ սուրացին դեպի ականջից ականջ բացված լոզառեխը։
