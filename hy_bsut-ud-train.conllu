# sent_id = reviews-007B-00090D1I
# text = Եթե մենք կրկին, ինչ-ինչ անձնական շահեր հաշվի առնելով, ինչպես եղավ 1998-ին, ինչ-ինչ անիրական ցանկություններ կյանքի կոչել փորձելով, ինչպես վարվել ենք վերջին 23 տարիների ընթացքում, ճիշտ չկողմնորոշվենք, ճիշտ հաշվարկ չանենք, վաղն ավելին ենք կորցնելու։
